<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="linkedin_config_list_view" model="ir.ui.view">
        <field name="name">linkedin.config.list.view</field>
        <field name="model">linkedin.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="linkedin_config_form_view" model="ir.ui.view">
        <field name="name">linkedin.config.form.view</field>
        <field name="model">linkedin.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_auth_linkedin" string="Auth LinkedIn" type="object" class="oe_highlight"
                            invisible="state == 'connected'"/>
                    <button name="action_get_linkedin_user" string="Get User Info" type="object" class="oe_highlight"
                            invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="client_id" string="Client ID"/>
                            <field name="client_secret"/>
                            <field name="oauth_scopes"/>
                            <field name="linkedin_user" string="LinkedIn User" readonly="1"/>
                        </group>
                        <group>
                            <field name="auth_token"  readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_linkedin_config" model="ir.actions.act_window">
        <field name="name">Linkedin Configration</field>
        <field name="res_model">linkedin.config</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your Linkedin Configration ..
            </p>
        </field>
    </record>
    <menuitem id="linkedin_root_menu"
              name="Linkedin"
              web_icon="linkedin_integration,static/description/icon.png"
    />
    <menuitem id="linkedin_config_menu"
              name="Configration"
              parent="linkedin_root_menu"
              action="action_linkedin_config"
              sequence="10"/>

</odoo>