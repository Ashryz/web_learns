<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="linkedin_success_template" name="Success LinkedIn Profile">
        <t t-call="web.layout">
            <div class="container mt-5">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-body text-center">
                                <div class="mb-3">
                                    <i class="fa fa-check-circle fa-3x text-success"/>
                                </div>
                                <h4 class="card-title text-success">
                                    Authorization Successful.
                                </h4>
                            </div>
                            <div class="mt-4">
                                    <button type="button" class="btn btn-primary" onclick="window.close();">Close </button>
                                </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
        <template id="linkedin_failed_template" name="Failed LinkedIn Profile">
        <t t-call="web.layout">
            <div class="container mt-5">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-body text-center">
                                <div class="mb-3">
                                    <i class="fa fa-check-circle fa-3x text-danger"/>
                                </div>
                                <h4 class="card-title text-danger">
                                    Authorization Failed!
                                </h4>
                                <p class="card-text">
                                    <strong>Error</strong> <span t-esc="error"/>
                                </p>
                                 <p class="card-text text-muted" t-if="error_description">
                                    <span t-esc="error_description"/>
                                </p>
                                <div class="mt-4">
                                    <button type="button" class="btn btn-primary" onclick="window.close();">Close </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>