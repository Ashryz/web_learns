<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_my_home_patient" name="Show Patients" customize_show="True"
              inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Patients</t>
                <t t-set="url" t-value="'/my/patients'"/>
                <t t-set="placeholder_count" t-value="'patients_count'"/>
            </t>
        </xpath>
    </template>
    <template id="portal_my_patients" name="My patients">
           <t t-call="portal.portal_layout">
           </t>
    </template>

</odoo>

