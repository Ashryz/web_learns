<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_purchaseorder_document_extends" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='o.payment_term_id']" position="after">
            <br/>
            <strong>Purchase Representative:</strong>
            <span t-field="o.user_id" class="mt-4"/>
            <br/>
            <strong>Purchase Team:</strong>
            <span t-field="o.user_id.sale_team_id" class="mt-4"/>
        </xpath>

        <xpath expr="//table[hasclass('o_has_total_table','table','o_main_table','table-borderless')]/thead/tr/th[@name='th_description']"
               position="before">
            <th name="th_seq" class="text-start">
                <strong>NO.</strong>
            </th>
        </xpath>
        <xpath expr="//table[hasclass('o_has_total_table','table','o_main_table','table-borderless')]/tbody/t[2]/tr/t/td[@id='product']"
               position="before">
            <td id="product_seq" class="text-start">
                <span t-esc="line_index + 1"/>
            </td>
        </xpath>
        <xpath expr="//table[hasclass('o_has_total_table','table','o_main_table','table-borderless')]"
               position="after">
            <div class="row">
                <div class="col-6">
                    <strong>Total quantity of all items:</strong>
                    <t t-set="total_qty" t-value="sum (line.product_qty for line in o.order_line if not line.display_type)"/>
                    <span t-esc="total_qty"/>
                </div>
            </div>
        </xpath>
    </template>

</odoo>