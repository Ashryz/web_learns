<odoo>
    <data noupdate="1">
        <record id="equipment_category_inventory_manager_rule" model="ir.rule">
            <field name="name">Equipment Category Inventory Manager</field>
            <field name="model_id" ref="model_equipment_category"/>
            <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
        </record>

        <record id="equipment_category_inventory_admin_rule" model="ir.rule">
            <field name="name">Equipment Category Inventory Admin</field>
            <field name="model_id" ref="model_equipment_category"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>