<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_form_inherited" model="ir.ui.view">
        <field name="name">purchase.order.form.inherited</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group[2]" position="inside">
                <field name="product_lst_ids" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='products']/field[@name='order_line']/list/field[@name='product_id']"
                   position="after">
                <field name="equipment_category_id"/>
            </xpath>
            <xpath expr="//page[@name='products']/field[@name='order_line']/list/field[@name='product_id']"
                   position="attributes">
                <attribute name="domain">[('id','in',parent.product_lst_ids)]</attribute>
            </xpath>

        </field>
    </record>
</odoo>