<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="procurement_manager_wizard_form_view" model="ir.ui.view">
        <field name="name">procurement.manager.wizard.form.view</field>
        <field name="model">procurement.manager.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_open_procurement_report" string="Open Report" class="oe_highlight" type="object"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_procurement_manager_wizard" model="ir.actions.act_window">
        <field name="name">Procurement Action Wizard</field>
        <field name="res_model">procurement.manager.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="procurement_manager_wizard_menu"
              name="Procurement Manager Report"
              parent="purchase.purchase_report_main"
              action="action_procurement_manager_wizard"/>
</odoo>